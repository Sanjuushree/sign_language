# ISL Connect — Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=ISL Connect
APP_ENV=development
DEBUG=true

# ── Backend API ───────────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_HOST=localhost
FRONTEND_PORT=8501

# ── Database ──────────────────────────────────────────────────────────────────
# Path is relative to the project root. SQLite for local persistence.
DATABASE_PATH=database/isl_connect.db

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the FastAPI backend.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
